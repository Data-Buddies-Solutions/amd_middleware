# Copy to .env for local use only. Never commit real values.

# AdvancedMD API credentials (required)
ADVANCEDMD_USERNAME=your_username
ADVANCEDMD_PASSWORD=your_password
ADVANCEDMD_OFFICE_KEY=your_office_key
ADVANCEDMD_APP_NAME=your_app_name

# API security (API_SECRET required; use a distinct booking secret in production)
API_SECRET=random_secret_for_middleware_api
BOOKING_TOKEN_SECRET=random_secret_for_signed_slot_tokens

# Dedicated Cloud Scheduler OIDC identity (required; not an API secret)
MAINTENANCE_OIDC_AUDIENCE=https://middleware.example.test
MAINTENANCE_OIDC_SERVICE_ACCOUNT=middleware-maintenance@example.iam.gserviceaccount.com

# Acuity Product, the source of the published insurance catalog (required).
# The token is the middleware's own Product service credential with READ_INSURANCE.
ACUITY_PRODUCT_URL=http://127.0.0.1:8090
ACUITY_PRODUCT_INSURANCE_TOKEN=product_service_token_with_read_insurance

# Runtime configuration
PORT=8080
# prod or sandbox; any other value stops startup
AMD_ENV=sandbox
